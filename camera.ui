<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Camera</class>
 <widget class="QWidget" name="Camera">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1440</width>
    <height>900</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>900</width>
    <height>620</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>MVIC · 视觉识别平台</string>
  </property>
  <property name="styleSheet">
   <string>/* ===== MVIC · 浅色控制台主题 ===== */
* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
}
QWidget#Camera {
    background-color: #F5F7FB;
    font-size: 14px;
    color: #1F2937;
}

/* ---------- 顶栏 ---------- */
QFrame#topBar {
    background-color: #FFFFFF;
    border: 1px solid #E6EBF3;
    border-radius: 14px;
}
QLabel#appBadge {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3B7BFF, stop:1 #2355DE);
    color: #FFFFFF;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 700;
}
QLabel#appTitle { font-size: 18px; font-weight: 700; color: #101828; }
QLabel#appSubTitle { font-size: 12px; color: #8C98AA; }
QLabel#versionTag, QLabel#ocrBadge, QLabel#pageTag, QLabel#pageTag_2, QLabel#pageTag_3 {
    font-size: 11px;
    border-radius: 9px;
    padding: 5px 11px;
}
QLabel#versionTag { color: #2F6BFF; background-color: #EDF3FF; border: 1px solid #D6E4FF; }
QLabel#ocrBadge { color: #15803D; background-color: #ECFDF3; border: 1px solid #CDEFD9; }
QLabel#pageTag, QLabel#pageTag_2, QLabel#pageTag_3 {
    color: #667085; background-color: #FFFFFF; border: 1px solid #E6EBF3;
}

/* ---------- 页面标题 ---------- */
QFrame#pageHeader, QFrame#pageHeader_2, QFrame#pageHeader_3 {
    background: transparent;
    border: none;
}
QLabel#pageTitle, QLabel#pageTitle_2, QLabel#pageTitle_3 {
    font-size: 19px; font-weight: 700; color: #101828;
}
QLabel#pageSubtitle, QLabel#pageSubtitle_2, QLabel#pageSubtitle_3 {
    font-size: 12px; color: #8C98AA;
}

/* ---------- 侧边导航 ---------- */
QFrame#sidebarPanel {
    background-color: #FFFFFF;
    border: 1px solid #E6EBF3;
    border-radius: 14px;
}
QLabel#navCaption { font-size: 11px; font-weight: 600; color: #8C98AA; }
QLabel#navFooter { font-size: 11px; color: #B6BFCC; }
QFrame#navDivider, QFrame#toolDivider {
    background: #EDF1F7; border: none; min-height: 1px; max-height: 1px;
}
QListWidget#listWidget {
    background-color: transparent;
    border: none;
    padding: 2px 0px;
    outline: 0px;
    font-size: 14px;
}
QListWidget#listWidget::item {
    color: #475467;
    padding: 11px 12px;
    border-radius: 9px;
    border-left: 3px solid transparent;
    margin: 2px 0px;
}
QListWidget#listWidget::item:hover { background-color: #F3F7FF; color: #1D4ED8; }
QListWidget#listWidget::item:selected {
    background-color: #EAF1FF;
    color: #1D4ED8;
    font-weight: 600;
    border-left: 3px solid #2F6BFF;
}

/* ---------- 文本 ---------- */
QLabel { color: #475467; font-size: 14px; }
QLabel#label_hint, QLabel#label_hint_2 { color: #8C98AA; font-size: 12px; }
QLabel#paramNote, QLabel#paramNoteImage { font-size: 11px; color: #8C98AA; }
QLabel#queryCaption, QLabel#editCaption,
QLabel#resultPlateCaption, QLabel#resultNameCaption,
QLabel#resultPlateCaptionImage, QLabel#resultNameCaptionImage {
    font-size: 11px; font-weight: 600; color: #8C98AA;
}

/* ---------- 卡片容器 ---------- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E6EBF3;
    border-radius: 14px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #344054;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 2px;
    padding: 0 6px;
    color: #667085;
    font-size: 13px;
    font-weight: 600;
}
QFrame#toolCard {
    background-color: #FFFFFF;
    border: 1px solid #E6EBF3;
    border-radius: 14px;
}

/* ---------- 取景器 ---------- */
QLabel#label_display, QLabel#label_display_image {
    background-color: #0C1424;
    border: 1px solid #1B263B;
    border-radius: 12px;
    color: #64748B;
    font-size: 14px;
}

/* ---------- 识别结果 ---------- */
QLabel#label_result, QLabel#label_result_image {
    background-color: #F1F6FF;
    border: 1px solid #DCE8FF;
    border-radius: 9px;
    color: #1D4ED8;
    font-size: 20px;
    font-weight: 700;
    padding: 9px 12px;
    min-height: 22px;
}
QLabel#label_result_name, QLabel#label_result_image_name {
    background-color: #F8FAFC;
    border: 1px solid #EEF2F6;
    border-radius: 8px;
    color: #344054;
    font-size: 14px;
    font-weight: 600;
    padding: 7px 12px;
    min-height: 18px;
}
QLabel#label_frame_py, QLabel#label_result_image_py {
    background-color: #F7FAFF;
    border: 1px solid #E7EEFC;
    border-radius: 8px;
    color: #5A6B85;
    font-size: 12px;
    padding: 7px 10px;
    min-height: 16px;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #DCE3ED;
    border-radius: 9px;
    padding: 8px 14px;
    min-height: 20px;
    color: #344054;
    font-size: 14px;
    font-weight: 500;
}
QPushButton:hover { background-color: #F3F7FF; border-color: #A9C2FF; color: #1D4ED8; }
QPushButton:pressed { background-color: #E3ECFF; }
QPushButton:disabled { background-color: #F2F4F7; color: #B0B8C4; border-color: #E6EBF3; }

QPushButton#find_btn, QPushButton#btn_find_car {
    background-color: #2F6BFF; border: 1px solid #2F6BFF; color: #FFFFFF;
}
QPushButton#find_btn:hover, QPushButton#btn_find_car:hover {
    background-color: #1D5AEF; border-color: #1D5AEF; color: #FFFFFF;
}
QPushButton#find_btn:pressed, QPushButton#btn_find_car:pressed {
    background-color: #1748C6; border-color: #1748C6; color: #FFFFFF;
}

QPushButton#open_btn, QPushButton#open_btn_image, QPushButton#btn_add_plate {
    background-color: #16A34A; border: 1px solid #16A34A; color: #FFFFFF;
}
QPushButton#open_btn:hover, QPushButton#open_btn_image:hover, QPushButton#btn_add_plate:hover {
    background-color: #128C3E; border-color: #128C3E; color: #FFFFFF;
}
QPushButton#open_btn:pressed, QPushButton#open_btn_image:pressed, QPushButton#btn_add_plate:pressed {
    background-color: #0F7534; border-color: #0F7534; color: #FFFFFF;
}
QPushButton#open_btn:disabled, QPushButton#open_btn_image:disabled {
    background-color: #EAF7EF; color: #A5CBB5; border-color: #D9EDE2;
}

QPushButton#close_btn, QPushButton#btn_delete_plate {
    background-color: #FFFFFF; border: 1px solid #F3B9B9; color: #DC2626;
}
QPushButton#close_btn:hover, QPushButton#btn_delete_plate:hover {
    background-color: #FEF2F2; border-color: #DC2626; color: #B91C1C;
}
QPushButton#close_btn:pressed, QPushButton#btn_delete_plate:pressed {
    background-color: #FCE7E7;
}
QPushButton#close_btn:disabled {
    background-color: #F2F4F7; color: #C4B3B3; border-color: #E6EBF3;
}

QPushButton#start_btn, QPushButton#start_btn_image {
    background-color: #0EA5A0; border: 1px solid #0EA5A0; color: #FFFFFF;
}
QPushButton#start_btn:hover, QPushButton#start_btn_image:hover {
    background-color: #0B8E8A; border-color: #0B8E8A; color: #FFFFFF;
}
QPushButton#start_btn:pressed, QPushButton#start_btn_image:pressed {
    background-color: #097673; border-color: #097673; color: #FFFFFF;
}
QPushButton#start_btn:disabled, QPushButton#start_btn_image:disabled {
    background-color: #E6F7F6; color: #9CC9C7; border-color: #D3EDEB;
}

QPushButton#stop_btn {
    background-color: #EF4444; border: 1px solid #EF4444; color: #FFFFFF;
}
QPushButton#stop_btn:hover { background-color: #DC2626; border-color: #DC2626; color: #FFFFFF; }
QPushButton#stop_btn:pressed { background-color: #B91C1C; border-color: #B91C1C; color: #FFFFFF; }
QPushButton#stop_btn:disabled { background-color: #FDECEC; color: #DCA9A9; border-color: #F7D9D9; }

/* ---------- 输入控件 ---------- */
QComboBox, QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #DCE3ED;
    border-radius: 9px;
    padding: 8px 11px;
    min-height: 20px;
    color: #1F2937;
    font-size: 14px;
}
QComboBox:hover, QLineEdit:hover { border-color: #A9C2FF; }
QLineEdit:focus { border-color: #2F6BFF; background-color: #FBFCFF; }
QLineEdit { selection-background-color: #2F6BFF; selection-color: #FFFFFF; }
QComboBox:disabled, QLineEdit:disabled {
    background-color: #F2F4F7; color: #AFB7C4; border-color: #E6EBF3;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #7A869A;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E6EBF3;
    border-radius: 9px;
    padding: 4px;
    selection-background-color: #EDF3FF;
    selection-color: #1D4ED8;
    outline: 0px;
}

/* ---------- 单选 / 复选 ---------- */
QRadioButton, QCheckBox { spacing: 8px; color: #344054; }
QRadioButton::indicator {
    width: 16px; height: 16px; border-radius: 8px;
    border: 1px solid #C3CDDB; background-color: #FFFFFF;
}
QRadioButton::indicator:checked { border: 5px solid #2F6BFF; background-color: #FFFFFF; }
QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 4px;
    border: 1px solid #C3CDDB; background-color: #FFFFFF;
}
QCheckBox::indicator:checked { background-color: #2F6BFF; border: 1px solid #2F6BFF; }

/* ---------- 滚动区域 ---------- */
QScrollArea#sideScroll, QScrollArea#sideScroll_2 { background: transparent; border: none; }
QScrollArea#sideScroll &gt; QWidget &gt; QWidget,
QScrollArea#sideScroll_2 &gt; QWidget &gt; QWidget { background: transparent; }
QScrollBar:vertical { background: #F0F3F8; width: 10px; margin: 0px; border: none; }
QScrollBar::handle:vertical { background: #BCC8DA; border-radius: 4px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: #94A7C0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0px; border: none; }
QScrollBar::handle:horizontal { background: #D8E0EC; border-radius: 4px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: #B9C6D8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFE;
    gridline-color: #EDF1F7;
    border: 1px solid #E6EBF3;
    border-radius: 10px;
    color: #1F2937;
    font-size: 14px;
    selection-background-color: #DCE8FF;
    selection-color: #1D4ED8;
}
QTableWidget::item { padding: 10px 12px; border: none; }
QTableWidget::item:selected { background-color: #DCE8FF; color: #1D4ED8; }
QHeaderView::section {
    background-color: #F5F8FD;
    color: #475467;
    font-weight: 600;
    font-size: 13px;
    padding: 10px 12px;
    border: none;
    border-bottom: 2px solid #E2E9F5;
    border-right: 1px solid #EDF1F7;
}
QHeaderView::section:horizontal { border-top-left-radius: 10px; border-top-right-radius: 10px; }
QTableWidget QTableCornerButton::section {
    background-color: #F5F8FD; border: none; border-bottom: 2px solid #E2E9F5;
}
QTableWidget::verticalHeader {
    background-color: #FAFBFE; color: #9AA4B2; font-size: 12px;
    border: none; border-right: 1px solid #EDF1F7;
}
QTableWidget::verticalHeader::section { padding: 6px; }

/* ---------- 其它 ---------- */
QToolTip {
    background-color: #1F2937; color: #FFFFFF;
    border: none; border-radius: 6px; padding: 6px 9px; font-size: 12px;
}
QStackedWidget { background-color: transparent; }
</string>
